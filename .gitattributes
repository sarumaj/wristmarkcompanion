# Binary files are kept in Git LFS: the repository holds a pointer, Forgejo's LFS store the
# file (docs/ci.md#binary-files). CI's checkouts fetch them (lfs: true).
*.png filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.iq filter=lfs diff=lfs merge=lfs -text
*.apk filter=lfs diff=lfs merge=lfs -text
*.task filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
# Except the viewer's own files: the app panel builds its image from a plain clone,
# which isn't known to fetch LFS (docs/ci.md#binary-files), so they stay in Git.
viewer/public/** !filter !diff !merge
viewer/public/** !text -filter -merge -diff
app/android/** !text -filter -merge -diff
